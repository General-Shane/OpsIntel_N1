# OPSINTEL Enterprise Operations Intelligence
# Configuration Template (.env.example)

PROJECT_NAME="OPSINTEL Enterprise Operations Intelligence"
ENVIRONMENT="development"
SECRET_KEY="replace-with-a-secure-random-64-character-key"
DATABASE_URL="sqlite:///./opsintel.db"

# Default Bootstrap Users
OPSINTEL_BOOTSTRAP_ADMIN_USERNAME="admin"
OPSINTEL_BOOTSTRAP_ADMIN_PASSWORD="Admin@ChangeMe123"
OPSINTEL_BOOTSTRAP_VIEWER_USERNAME="viewer"
OPSINTEL_BOOTSTRAP_VIEWER_PASSWORD="Viewer@ChangeMe123"
OPSINTEL_BOOTSTRAP_ANALYST_USERNAME="analyst"
OPSINTEL_BOOTSTRAP_ANALYST_PASSWORD="Analyst@ChangeMe123"

# Beacon Multi-Agent Security
BEACON_API_KEY="opsintel-beacon-dev-key-2026"

# ServiceNow Integration (Stage 8)
SERVICE_NOW_INSTANCE_URL="https://devXXXXX.service-now.com"
SERVICE_NOW_AUTH_MODE="basic"
SERVICE_NOW_USERNAME="admin"
SERVICE_NOW_PASSWORD="your-servicenow-password"
SERVICE_NOW_CLIENT_ID=""
SERVICE_NOW_CLIENT_SECRET=""
SERVICE_NOW_WEBHOOK_SECRET="opsintel-sn-webhook-secret-2026"
SERVICE_NOW_RATE_LIMIT_RPS=10.0
SERVICE_NOW_CONFLICT_POLICY="SERVICENOW_WINS"

# SMTP & Notifications (Stage 9)
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="notifications@example.com"
SMTP_PASSWORD="your-smtp-password"
SMTP_USE_TLS=True
SMTP_MOCK_MODE=True

# AI Services (Optional)
GEMINI_API_KEY=""
